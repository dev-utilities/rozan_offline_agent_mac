{
  "manifest_version": 3,
  "name": "Rozan Bridge",
  "version": "0.3.0",
  "description": "Lets your local Rozan open, read and (with your approval) click in Chrome. Talks only to the agent on this Mac.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "120",
  "incognito": "spanning",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
